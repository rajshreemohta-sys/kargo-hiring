# Copy to .env.local and fill in. All server-only (no NEXT_PUBLIC_), so none reach the browser.

# Neon Postgres (console.neon.tech → your project → Connect). If you add Neon through the
# Vercel integration, both are set for you automatically.
# Pooled string (host contains "-pooler"), used by the app:
DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
# Direct string, used only by `npm run db:migrate`:
DATABASE_URL_UNPOOLED=postgresql://.../neondb?sslmode=require

# Gemini (aistudio.google.com → Get API key). Scores the redacted CVs.
GEMINI_API_KEY=
# Optional model override. Default: gemini-3.8-flash
GEMINI_MODEL=

# Resend (resend.com → API keys). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=re_...
EMAIL_FROM="Arjun Mehta <arjun@kargo.in>"
# Optional: where candidate replies go.
EMAIL_REPLY_TO=

# Team sign-in. SESSION_SECRET: any random 32+ characters (e.g. `openssl rand -base64 32`).
TEAM_PASSWORD=
SESSION_SECRET=
