# Copy to .env.local and fill in. All server-only (no NEXT_PUBLIC_), so none reach the browser.

# Netlify Database (Netlify → your project → Data & Storage → Database → connection string).
# Used by the app and by `npm run db:migrate`.
NETLIFY_DATABASE_URL=postgres://...

# Netlify Blobs, for the original CV files. Site ID: Project configuration → General → Project information.
# Token: a Netlify personal access token (User settings → Applications → Personal access tokens).
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# Claude (console.anthropic.com → API keys). Scores the redacted CVs.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override. Default: claude-opus-5
ANTHROPIC_MODEL=

# Resend (resend.com → API keys). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=re_...
EMAIL_FROM="Arjun Mehta <arjun@kargo.in>"
# Optional: where candidate replies go.
EMAIL_REPLY_TO=

# Team sign-in. SESSION_SECRET: any random 32+ characters (e.g. `openssl rand -base64 32`).
TEAM_PASSWORD=
SESSION_SECRET=
